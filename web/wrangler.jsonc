{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaerhona",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Run the Worker next to MongoDB Atlas and S3, which are both in this region.
  "placement": {
    "region": "aws:eu-west-1"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "xn--vrhna-sra2k.no", "custom_domain": true },
    { "pattern": "www.xn--vrhna-sra2k.no", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vaerhona"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "vaerhona-next-cache"
    },
    {
      "binding": "LATEST_R2_BUCKET",
      "bucket_name": "vaerhona-latest"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
